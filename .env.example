# Copy to .env and fill in ONE provider. run.sh loads this file.
# LLM_PROVIDER picks the backend: openai | anthropic | gemini | xai | groq | openrouter | mock
# If LLM_PROVIDER is empty, the first key found below is used; with no key the app runs the offline demo analyzer.
# OpenRouter default is google/gemini-2.5-flash (cheap). On 402 it tries other cheap models on the same key.
LLM_PROVIDER=
LLM_MODEL=
# LLM_MODELS=google/gemini-2.5-flash,openai/gpt-4o-mini   # extra OpenRouter fallbacks
# LLM_BASE_URL=http://localhost:11434/v1   # any OpenAI-compatible server (Ollama, vLLM, LM Studio)

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
